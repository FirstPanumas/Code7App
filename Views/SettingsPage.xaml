<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Code7App.ViewModels"
             x:Class="Code7App.Views.SettingsPage"
             Title="System Settings"
             BackgroundColor="{StaticResource MainBgColor}">
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#F0F0F0" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="TextColor" Value="Black" />
            <!-- เพิ่ม Padding ให้ข้อความไม่ชิดขอบจนเกินไป (รองรับเฉพาะบาง Platform แต่ใส่เผื่อไว้) -->
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto, *, Auto">
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20" BackgroundColor="#F5F5F5">
            <Label Grid.Column="0" Text="Configuration Settings" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Import Total Setting (.json/.txt)" Command="{Binding ImportTotalSettingCommand}" 
                    BackgroundColor="{StaticResource ModalHeaderColor}" TextColor="White" HeightRequest="40" />
        </Grid>

        <!-- BODY -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="20">

                <!-- 1. Patient Register Settings -->
                <Border BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="1. Patient Register" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource SidebarBgColor}" />

                        <Grid ColumnDefinitions="150, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                            <!-- ... (Row 0 ถึง Row 4 คงเดิม) ... -->
                            <Label Grid.Row="0" Grid.Column="0" Text="Default CSV Path:" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Config.PatientRegister.DefaultPath}" IsReadOnly="True" />
                            <Button Grid.Row="0" Grid.Column="2" Text="Browse..." Command="{Binding BrowseCsvPathCommand}" CommandParameter="Patient" HeightRequest="40" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Flag Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.PatientRegister.FlagColumn, Mode=TwoWay}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Dropdown Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.PatientRegister.DropdownColumn, Mode=TwoWay}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Calculate Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.PatientRegister.CalculateColumn, Mode=TwoWay}" />

                            <Label Grid.Row="4" Grid.Column="0" Text="Form Columns:" VerticalOptions="Center" />
                            <Entry Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.PatientRegister.FormDisplayColumns, Mode=TwoWay}" Placeholder="e.g., MRN,Name,Age" />

                            <!-- เพิ่ม Row 5: ตั้งค่าแผนก -->
                            <Label Grid.Row="5" Grid.Column="0" Text="Department List:" VerticalOptions="Center" />
                            <Entry Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.PatientRegister.DepartmentList, Mode=TwoWay}" Placeholder="คั่นด้วยคอมมา" />

                            <!-- เพิ่ม Row 6: ตั้งค่าแพทย์ -->
                            <Label Grid.Row="6" Grid.Column="0" Text="Doctor List:" VerticalOptions="Center" />
                            <Entry Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.PatientRegister.DoctorList, Mode=TwoWay}" Placeholder="คั่นด้วยคอมมา" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Order Item Settings -->
                <Border BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="2. Order Item" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource SidebarBgColor}" />
                        <Grid ColumnDefinitions="150, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Default CSV Path:" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Config.OrderItem.DefaultPath}" IsReadOnly="True" />
                            <Button Grid.Row="0" Grid.Column="2" Text="Browse..." Command="{Binding BrowseCsvPathCommand}" CommandParameter="Item" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Flag Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.OrderItem.FlagColumn, Mode=TwoWay}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Dropdown Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.OrderItem.DropdownColumn, Mode=TwoWay}" />
                            <Label Grid.Row="3" Grid.Column="0" Text="Calculate Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.OrderItem.CalculateColumn, Mode=TwoWay}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Order Set Settings -->
                <Border BackgroundColor="White" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Padding="20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="3. Order Set" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource SidebarBgColor}" />
                        <Grid ColumnDefinitions="150, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Default CSV Path:" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Config.OrderSet.DefaultPath}" IsReadOnly="True" />
                            <Button Grid.Row="0" Grid.Column="2" Text="Browse..." Command="{Binding BrowseCsvPathCommand}" CommandParameter="Set" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Flag Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.OrderSet.FlagColumn, Mode=TwoWay}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Dropdown Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.OrderSet.DropdownColumn, Mode=TwoWay}" />
                            <Label Grid.Row="3" Grid.Column="0" Text="Calculate Column:" VerticalOptions="Center" />
                            <Entry Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Config.OrderSet.CalculateColumn, Mode=TwoWay}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Padding="20" BackgroundColor="#F5F5F5">
            <HorizontalStackLayout HorizontalOptions="End" Spacing="15">
                <Button Text="SAVE SETTINGS" Command="{Binding SaveSettingsCommand}" BackgroundColor="#265267" TextColor="White" FontAttributes="Bold" WidthRequest="150" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>

</ContentPage>