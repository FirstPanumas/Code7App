<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Code7App.ViewModels"
             xmlns:models="clr-namespace:Code7App.Models"
             x:Class="Code7App.Views.OrderPage"
             x:DataType="vm:OrderViewModel"
             Title="Order"
             BackgroundColor="#F4F6F8">

    <!-- ใช้ Grid ชั้นนอกสุดเพื่อแยก Main UI กับ WebView ออกจากกัน -->
    <Grid>

        <!-- ================= MAIN UI ================= -->
        <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">

            <!-- 1. HEADER: Back Button & Patient Form (แบ่งซ้าย-ขวา) -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="15">

                <!-- ปุ่มกลับ -->
                <Button Grid.Column="0" Text="&lt; กลับ" Command="{Binding GoBackCommand}" 
                        BackgroundColor="Transparent" TextColor="#1565C0" FontAttributes="Bold"
                        VerticalOptions="Start" Margin="0,5,0,0"/>

                <!-- แบ่งพื้นที่ ซ้าย(ข้อมูลเดิม 4 ส่วน) ขวา(ฟอร์มกรอก 6 ส่วน) -->
                <Grid Grid.Column="1" ColumnDefinitions="4*, 6*" ColumnSpacing="15">

                    <!-- ส่วน 1.1 ข้อมูลคนไข้ (ด้านซ้าย) -->
                    <Border Grid.Column="0" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="12" VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📝 ข้อมูลผู้ป่วย" FontAttributes="Bold" FontSize="14" TextColor="#333333" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DisplayPatientDetails}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:PatientDetailModel">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{Binding Key, StringFormat='{0}:'}" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
                                            <Label Text="{Binding Value}" FontAttributes="Bold" FontSize="13" TextColor="Black" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!-- ส่วน 1.2 ฟอร์มกรอกข้อมูลเพิ่มเติม (ด้านขวา) -->
                    <Border Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="12" VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="15" RowSpacing="10">

                            <!-- แถว 1: วันที่ / เวลา -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="วันที่ *" TextColor="Gray" FontSize="11" />
                                <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="35">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <DatePicker Date="{Binding OrderDate}" Format="dd/MM/yyyy" Margin="5,0" BackgroundColor="Transparent" TextColor="Black" FontSize="13"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                <Label Text="เวลา (ชม.:นาที) *" TextColor="Gray" FontSize="11" />
                                <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="35">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto, *" Margin="5,0">
                                        <!-- Dropdown ชั่วโมง -->
                                        <Picker Grid.Column="0" 
                                                ItemsSource="{Binding HourList}" 
                                                SelectedItem="{Binding SelectedHour}" 
                                                BackgroundColor="Transparent"
                                                TextColor="Black"
                                                FontSize="13" 
                                                HorizontalTextAlignment="Center" />

                                        <!-- ตัวคั่น -->
                                        <Label Grid.Column="1" Text=":" VerticalOptions="Center" FontAttributes="Bold" TextColor="Black" />

                                        <!-- Dropdown นาที -->
                                        <Picker Grid.Column="2" 
                                                ItemsSource="{Binding MinuteList}" 
                                                SelectedItem="{Binding SelectedMinute}" 
                                                BackgroundColor="Transparent"
                                                TextColor="Black"
                                                FontSize="13" 
                                                HorizontalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- แถว 2: แผนก / แพทย์ -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                <Label Text="แผนก *" TextColor="Gray" FontSize="11" />
                                <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="35">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Picker ItemsSource="{Binding DepartmentList}" 
                                            SelectedItem="{Binding SelectedDepartment}" 
                                            Margin="5,0" 
                                            BackgroundColor="Transparent" 
                                            TextColor="Black"
                                            FontSize="13"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="แพทย์ *" TextColor="Gray" FontSize="11" />
                                <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="35">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Picker ItemsSource="{Binding DoctorList}" 
                                            SelectedItem="{Binding SelectedDoctor}" 
                                            Margin="5,0" 
                                            BackgroundColor="Transparent" 
                                            TextColor="Black"
                                            FontSize="13"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- แถว 3: อาการ / การแพ้ (ลบบล็อกที่ซ้ำซ้อนออกแล้ว) -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                <Label Text="Symptoms (อาการเบื้องต้น)" TextColor="Gray" FontSize="11" />
                                <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="60">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Editor Text="{Binding Symptoms}" Margin="5,2" BackgroundColor="Transparent" TextColor="Black" FontSize="13"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                <Label Text="Allergy (อาการแพ้)" TextColor="Gray" FontSize="11" />
                                <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="60">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Editor Text="{Binding Allergy}" Margin="5,2" BackgroundColor="Transparent" TextColor="Black" FontSize="13"/>
                                </Border>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                </Grid>
            </Grid>

            <!-- 2. SEARCH & FILTER ZONE -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *, Auto" ColumnSpacing="15">

                <!-- ช่องค้นหา (ซ้าย) -->
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="ค้นหารายการ" FontSize="12" TextColor="Gray" FontAttributes="Bold" Margin="2,0,0,0" />
                    <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="🔍" VerticalOptions="Center" Margin="10,0,5,0" />
                            <Entry Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}" 
                               Placeholder="รหัส หรือชื่อ Order..." 
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Dropdown Filter (ขวา) -->
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="{Binding FilterLabel}" FontSize="12" TextColor="Gray" FontAttributes="Bold" Margin="2,0,0,0" />
                    <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Picker ItemsSource="{Binding FilterOptions}"
                            SelectedItem="{Binding SelectedFilterValue, Mode=TwoWay}"
                            TextColor="Black" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Fill"
                            Margin="10,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Loading Indicator (ขวาสุด) -->
                <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsLoading}" 
                               VerticalOptions="End" Margin="0,0,0,8" WidthRequest="24" HeightRequest="24" Color="#1565C0"/>
            </Grid>

            <!-- 3. WORKSPACE -->
            <Grid Grid.Row="2" ColumnDefinitions="6*, 4*" ColumnSpacing="20">

                <!-- Left: Order List (Dynamic Column Rendering) -->
                <CollectionView Grid.Column="0" ItemsSource="{Binding AvailableOrders}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:OrderItemModel">
                            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15" Margin="0,0,0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">

                                    <!-- วนลูปวาดข้อมูลตาม FormDisplayColumns -->
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" 
                                                         BindableLayout.ItemsSource="{Binding DisplayFields}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:PatientDetailModel">
                                                <Grid ColumnDefinitions="120, *" Margin="0,2">
                                                    <Label Grid.Column="0" Text="{Binding Key, StringFormat='{0}:'}" 
                                                           TextColor="Gray" FontSize="13" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1" Text="{Binding Value}" 
                                                           TextColor="Black" FontAttributes="Bold" FontSize="14" 
                                                           LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- ปุ่มเพิ่มลงตะกร้า -->
                                    <Button Grid.Column="1" Text="+ เพิ่ม" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderViewModel}}, Path=AddToCartCommand}" 
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#1565C0" TextColor="White" FontAttributes="Bold" 
                                            HeightRequest="40" WidthRequest="80" CornerRadius="6" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Right: Cart & Checkout -->
                <Border Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="15">

                        <Label Grid.Row="0" Text="🛒 ตะกร้าสินค้า" FontAttributes="Bold" FontSize="18" TextColor="#333333"/>

                        <CollectionView Grid.Row="1" ItemsSource="{Binding CartItems}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CartItemModel">
                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,12" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="{Binding OrderName}" FontAttributes="Bold" FontSize="14" TextColor="Black" LineBreakMode="TailTruncation" MaxLines="1"/>
                                            <Label Text="{Binding TotalPrice, StringFormat='฿{0:N2}'}" FontSize="13" TextColor="#2E7D32" Margin="0,2,0,0"/>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1" Stroke="#E0E0E0" StrokeThickness="1" Padding="10,5" VerticalOptions="Center" BackgroundColor="#F9F9F9">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Quantity, StringFormat='x{0}'}" FontAttributes="Bold" FontSize="14" TextColor="Black"/>
                                        </Border>

                                        <Button Grid.Column="2" Text="X" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                                TextColor="White" BackgroundColor="#D32F2F" FontAttributes="Bold"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderViewModel}}, Path=RemoveFromCartCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="ยังไม่มีรายการในตะกร้า" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <VerticalStackLayout Grid.Row="2" Spacing="15">
                            <BoxView HeightRequest="1" Color="#E0E0E0" />
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="รวมสุทธิ:" FontAttributes="Bold" FontSize="18" TextColor="Black" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding GrandTotal, StringFormat='฿{0:N2}'}" FontAttributes="Bold" FontSize="22" TextColor="#D32F2F" VerticalOptions="Center"/>
                            </Grid>
                            <Button Text="🖨️ สั่งพิมพ์ / ยืนยัน Order" 
                                    Command="{Binding CheckoutAndPrintCommand}" 
                                    BackgroundColor="#1565C0" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="8"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= HIDDEN WEBVIEW ================= -->
        <!-- WEBVIEW สำหรับจัดการ PRINT (ซ่อนไว้ไม่ให้ผู้ใช้เห็น) -->
        <WebView x:Name="PrintHelperWebView" 
                 WidthRequest="800" 
                 HeightRequest="1000" 
                 TranslationX="-5000" 
                 InputTransparent="True" />

    </Grid>
</ContentPage>